<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Outfit Finder</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #f8f7ff;
      --text-main: #151525;
      --muted: #777894;
      --accent-pink: #ff4f8b;
      --accent-yellow: #ffc857;
      --accent-teal: #24b9b6;
      --card-radius: 20px;
      --shadow-soft: 0 18px 45px rgba(15, 23, 42, 0.12);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top right, #ffe3f1, #f8f7ff 45%),
                  radial-gradient(circle at bottom left, #e0f9ff, #f8f7ff 55%);
      color: var(--text-main);
    }
    .page { min-height: 100vh; display: flex; flex-direction: column; }

    header {
      max-width: 1120px; margin: 0 auto;
      padding: 1.5rem 1.25rem 0.5rem;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }
    .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; font-size: 1.1rem; }
    .brand-logo {
      width: 32px; height: 32px; border-radius: 999px;
      background: linear-gradient(135deg, #ff4f8b, #ffc857);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; color: #fff;
      box-shadow: 0 8px 20px rgba(255, 79, 139, 0.4);
    }
    nav { display: flex; gap: 1.25rem; font-size: 0.9rem; color: var(--muted); }
    nav a { text-decoration: none; color: inherit; }
    nav a.highlight { color: var(--accent-pink); font-weight: 500; }

    .hero {
      max-width: 1120px; margin: 0 auto;
      padding: 1.25rem 1.25rem 3rem;
      display: grid; grid-template-columns: minmax(0, 1.4fr); gap: 2rem;
    }
    .hero-main { max-width: 720px; }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.25rem 0.75rem; border-radius: 999px;
      background: rgba(255,255,255,0.8);
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      font-size: 0.75rem; color: var(--muted); margin-bottom: 0.9rem;
    }
    .eyebrow-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--accent-teal); }

    h1 {
      font-size: clamp(2.2rem, 4vw, 3rem);
      line-height: 1.1; margin: 0 0 0.8rem; letter-spacing: -0.03em;
    }
    h1 span.highlight {
      background: linear-gradient(135deg, #ff4f8b, #ffc857);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .hero-subtitle {
      color: var(--muted); max-width: 520px;
      font-size: 0.98rem; line-height: 1.55; margin-bottom: 1.5rem;
    }

    .chat-shell {
      background: rgba(255,255,255,0.95);
      border-radius: 24px; padding: 1rem 1.2rem 1.2rem;
      box-shadow: var(--shadow-soft);
      border: 1px solid rgba(148,163,184,0.22);
      display: flex; flex-direction: column; gap: 0.8rem;
    }
    .chat-label { font-size: 0.8rem; color: var(--muted); display: flex; align-items: center; gap: 0.4rem; }
    .chat-label-icon {
      width: 18px; height: 18px; border-radius: 999px;
      background: rgba(255,79,139,0.12);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem; color: var(--accent-pink);
    }
    .chat-row { display: flex; gap: 0.6rem; align-items: stretch; }
    .chat-input-wrap {
      position: relative; flex: 1; display: flex; align-items: center;
      background: #f5f5ff; border-radius: 999px; padding: 0.4rem 0.9rem;
    }
    .chat-input-wrap input {
      border: none; outline: none; background: transparent; font: inherit; width: 100%; padding: 0.35rem 0;
    }
    .chat-input-wrap input::placeholder { color: #a0a2c3; }
    .chat-pill {
      font-size: 0.78rem; padding: 0.12rem 0.55rem; border-radius: 999px;
      background: rgba(36,185,182,0.08); color: #3e7c7d; margin-left: auto; white-space: nowrap;
    }
    .chat-btn {
      border: none; outline: none; border-radius: 999px;
      padding: 0 1.4rem; font-size: 0.92rem; font-weight: 500; letter-spacing: 0.02em; cursor: pointer;
      background: linear-gradient(135deg, #ff4f8b, #ff7c5c);
      color: #fff; display: flex; align-items: center; gap: 0.4rem;
      box-shadow: 0 14px 30px rgba(255,79,139,0.55); white-space: nowrap;
    }
    .chat-btn span.icon { font-size: 1.1rem; transform: translateY(1px); }

    .chat-suggestions { display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.75rem; }
    .chip { padding: 0.2rem 0.7rem; border-radius: 999px; background: #f3f4ff; color: #4b4f7d; cursor: pointer; }
    .chip span { opacity: 0.55; }

    .outfits-section { margin-top: 2.6rem; }
    .outfits-header {
      display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.1rem;
    }
    .outfits-header h2 { font-size: 1.1rem; margin: 0; }
    .outfits-header p { margin: 0; font-size: 0.86rem; color: var(--muted); }

    .outfit-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }

    .outfit-card {
      border-radius: var(--card-radius);
      background: rgba(255,255,255,0.96);
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.16);
      border: 1px solid rgba(148,163,184,0.18);
      display: flex; flex-direction: column; min-height: 100%;
    }

    .outfit-img-wrap { position: relative; padding-top: 120%; overflow: hidden; }
    .outfit-img-wrap img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; transform: scale(1.02);
    }

    .outfit-tag {
      position: absolute; top: 10px; left: 10px;
      padding: 0.21rem 0.7rem; border-radius: 999px;
      font-size: 0.7rem; font-weight: 500;
      background: rgba(255,255,255,0.92); color: #4b4f7d; backdrop-filter: blur(6px);
    }
    .outfit-badge {
      position: absolute; bottom: 10px; right: 10px;
      padding: 0.21rem 0.7rem; border-radius: 999px; font-size: 0.7rem;
      background: rgba(21,21,37,0.82); color: #fff;
    }
    .badge-pill { display: inline-flex; align-items: center; gap: 0.2rem; }
    .badge-dot { width: 7px; height: 7px; border-radius: 999px; background: #22c55e; }

    .outfit-body { padding: 0.9rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1; }
    .outfit-title { font-size: 0.98rem; font-weight: 600; }
    .outfit-meta {
      font-size: 0.78rem; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    .outfit-items { font-size: 0.82rem; color: #4b4f7d; }
    .outfit-items span { opacity: 0.6; }

    .outfit-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 0.4rem; }
    .outfit-price { font-size: 0.88rem; font-weight: 500; }
    .outfit-price span {
      font-size: 0.7rem; color: var(--muted);
      text-transform: uppercase; margin-left: 0.3rem; letter-spacing: 0.06em;
    }
    .outfit-btn {
      border: none; outline: none; border-radius: 999px;
      padding: 0.35rem 0.95rem; font-size: 0.78rem; font-weight: 500; cursor: pointer;
      background: #151525; color: #fff; display: inline-flex; align-items: center; gap: 0.25rem;
    }
    .outfit-btn span.icon { font-size: 0.9rem; transform: translateY(1px); }

    .accent-wedding { box-shadow: 0 0 0 3px rgba(255,79,139,0.15), var(--shadow-soft); }
    .accent-party   { box-shadow: 0 0 0 3px rgba(255,200,87,0.24), var(--shadow-soft); }
    .accent-holiday { box-shadow: 0 0 0 3px rgba(36,185,182,0.2), var(--shadow-soft); }

    footer {
      margin-top: auto; padding: 1.2rem 1.25rem 1.8rem;
      font-size: 0.78rem; text-align: center; color: #9ca3af;
    }

    @media (max-width: 900px) { .outfit-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 680px) {
      header { flex-direction: column; align-items: flex-start; }
      nav { font-size: 0.82rem; }
      .hero { padding-top: 0.3rem; }
      .outfit-grid { grid-template-columns: minmax(0, 1fr); }
      .chat-row { flex-direction: column; }
      .chat-btn { justify-content: center; padding: 0.6rem 1.1rem; }
      .chat-input-wrap { padding-inline: 0.8rem; }
    }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <div class="brand">
        <div class="brand-logo">O</div>
        <span>Outfit Finder</span>
      </div>
      <nav>
        <a href="#" class="highlight">Occasion outfits</a>
        <a href="#">How it works</a>
        <a href="#">Sign in</a>
      </nav>
    </header>

    <main class="hero">
      <section class="hero-main">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Smart styling assistant · 3 full looks in seconds
        </div>

        <h1>
          Tell us the <span class="highlight">occasion</span>,  
          we build the outfit.
        </h1>

        <p class="hero-subtitle">
          Describe the wedding, party or trip you’re dressing for and get
          three complete, ready-to-buy looks. No mixing individual items —
          every suggestion is a full head-to-toe outfit.
        </p>

        <div class="chat-shell">
          <div class="chat-label">
            <div class="chat-label-icon">💬</div>
            Chat with your stylist
          </div>

          <div class="chat-row">
            <div class="chat-input-wrap">
              <input type="text"
                     placeholder="E.g. Summer wedding in Italy, I’m a guest and prefer bright colours…" />
              <div class="chat-pill">3 looks · under 10 seconds</div>
            </div>
            <button class="chat-btn">
              <span>Find outfits</span>
              <span class="icon">⚡</span>
            </button>
          </div>

          <div class="chat-suggestions">
            <div class="chip">“Black tie winter wedding”</div>
            <div class="chip">“Office party after work”</div>
            <div class="chip">“Beach holiday day-to-night”</div>
            <div class="chip"><span>+ Casual brunch, city break…</span></div>
          </div>
        </div>

        <section class="outfits-section">
          <div class="outfits-header">
            <h2>Example looks you might see</h2>
            <p>Each card is one complete outfit · buy everything in one go.</p>
          </div>

          <!-- ONE model image used for all three cards -->
          <div class="outfit-grid">
            <!-- Replace once and all cards update -->
            <!-- Pick a neutral “same woman” photo for mockup -->
            <script>
              const MODEL_IMAGE_URL =
                "https://images.pexels.com/photos/1589216/pexels-photo-1589216.jpeg";
            </script>

            <!-- CARD 1 -->
            <article class="outfit-card accent-wedding">
              <div class="outfit-img-wrap">
                <img src="https://images.pexels.com/photos/1589216/pexels-photo-1589216.jpeg"
                     alt="Model outfit for wedding guest" />
                <div class="outfit-tag">Wedding · Guest</div>
                <div class="outfit-badge">
                  <span class="badge-pill"><span class="badge-dot"></span> Full look</span>
                </div>
              </div>
              <div class="outfit-body">
                <div class="outfit-meta">Summer ceremony</div>
                <div class="outfit-title">Emerald Garden Party</div>
                <div class="outfit-items">
                  Floaty emerald midi dress · nude block heels · woven clutch · gold hoops.
                  <span>Perfect for outdoor vows &amp; garden photos.</span>
                </div>
                <div class="outfit-footer">
                  <div class="outfit-price">£215<span>total outfit</span></div>
                  <button class="outfit-btn">View full outfit <span class="icon">→</span></button>
                </div>
              </div>
            </article>

            <!-- CARD 2 -->
            <article class="outfit-card accent-party">
              <div class="outfit-img-wrap">
                <img src="https://images.pexels.com/photos/1589216/pexels-photo-1589216.jpeg"
                     alt="Model outfit for evening party" />
                <div class="outfit-tag">Evening party</div>
                <div class="outfit-badge">High-impact, low effort</div>
              </div>
              <div class="outfit-body">
                <div class="outfit-meta">Cocktail &amp; clubs</div>
                <div class="outfit-title">Neon City Nights</div>
                <div class="outfit-items">
                  Magenta mini dress · black strappy heels · micro cross-body bag · bold gold earrings.
                  <span>Designed to go straight from bar to dance floor.</span>
                </div>
                <div class="outfit-footer">
                  <div class="outfit-price">£179<span>full look</span></div>
                  <button class="outfit-btn">View full outfit <span class="icon">→</span></button>
                </div>
              </div>
            </article>

            <!-- CARD 3 -->
            <article class="outfit-card accent-holiday">
              <div class="outfit-img-wrap">
                <img src="https://images.pexels.com/photos/1589216/pexels-photo-1589216.jpeg"
                     alt="Model outfit for holiday" />
                <div class="outfit-tag">Holiday</div>
                <div class="outfit-badge">Carry-on friendly</div>
              </div>
              <div class="outfit-body">
                <div class="outfit-meta">Beach to dinner</div>
                <div class="outfit-title">Sunset Getaway Set</div>
                <div class="outfit-items">
                  Citrus tailored shorts · airy linen shirt · raffia tote · espadrille sandals.
                  <span>Wear as a set or mix through your whole trip.</span>
                </div>
                <div class="outfit-footer">
                  <div class="outfit-price">£162<span>all items</span></div>
                  <button class="outfit-btn">View full outfit <span class="icon">→</span></button>
                </div>
              </div>
            </article>
          </div>
        </section>
      </section>
    </main>

    <footer>
      Outfit Finder · Mockup UI — replace images, copy and URLs with your own brand content.
    </footer>
  </div>
</body>
</html>
